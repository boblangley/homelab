{% set collection_vars = {
  'maintenance_state_dir': maintenance_state_dir,
  'maintenance_apt_hosts': maintenance_targets,
  'maintenance_revision': maintenance_release_dir | basename,
} %}
description: Collect available APT updates and changes since the previous snapshot
working_dir: {{ maintenance_release_dir | to_json }}
timeout_sec: 300
{% if maintenance_settings.apt_schedule is defined %}
schedule: {{ maintenance_settings.apt_schedule | to_json }}
{% endif %}
env:
  - SSH_AUTH_SOCK: {{ maintenance_settings.ssh_auth_sock | to_json }}
steps:
  - name: collect
    run: >-
      ansible-playbook maintenance/apt/collect.yml
      --extra-vars {{ collection_vars | to_json | quote }}
