<!-- Managed by Ansible (homelab repo, role clickhouse). -->
<clickhouse>
    <listen_host>0.0.0.0</listen_host>

    <!-- Native TLS on 9440, HTTPS on 8443, and SSH on 9022 when a user has a key. -->
    <http_port remove="1"/>
    <tcp_port remove="1"/>
    <mysql_port remove="1"/>
    <postgresql_port remove="1"/>
    <interserver_http_port remove="1"/>
    <https_port>8443</https_port>
    <tcp_port_secure>9440</tcp_port_secure>
{% if clickhouse_ssh_enabled %}

    <tcp_ssh_port>9022</tcp_ssh_port>
    <ssh_server>
        <host_ed25519_key>/etc/clickhouse-server/config.d/ssh_host_ed25519_key</host_ed25519_key>
    </ssh_server>
{% endif %}

    <openSSL>
        <server>
            <certificateFile>/etc/clickhouse-server/tls/tls.crt</certificateFile>
            <privateKeyFile>/etc/clickhouse-server/tls/tls.key</privateKeyFile>
            <verificationMode>none</verificationMode>
            <disableProtocols>sslv2,sslv3,tlsv1,tlsv1_1</disableProtocols>
            <preferServerCiphers>true</preferServerCiphers>
        </server>
        <client>
            <!-- Outgoing TLS (NATS) trusts the host bundle, which has the homelab root. Named explicitly: ClickHouse's
                 static build doesn't find the system store by itself. -->
            <caConfig>/etc/ssl/certs/ca-certificates.crt</caConfig>
            <verificationMode>strict</verificationMode>
        </client>
    </openSSL>

    <max_server_memory_usage_to_ram_ratio>{{ clickhouse_memory_ratio }}</max_server_memory_usage_to_ram_ratio>

    <!-- Logs go to the container's output. -->
    <logger>
        <level>information</level>
        <log remove="1"/>
        <errorlog remove="1"/>
        <console>1</console>
    </logger>
</clickhouse>
