#!/bin/sh
# Managed by Ansible (homelab repo, role ntfy).
# Waits for the users and tokens from sidecar ntfy-secrets, then runs ntfy with them. They are read with cat, so the
# $ in a bcrypt hash is never expanded.
set -eu
i=0
until [ -s /secrets/auth_users ] && [ -s /secrets/auth_tokens ]; do
  i=$((i + 1))
  if [ "$i" -gt 120 ]; then
    echo "ntfy: no users and tokens from ntfy-secrets after 2 minutes" >&2
    exit 1
  fi
  sleep 1
done
NTFY_AUTH_USERS=$(cat /secrets/auth_users)
NTFY_AUTH_TOKENS=$(cat /secrets/auth_tokens)
export NTFY_AUTH_USERS NTFY_AUTH_TOKENS
exec ntfy serve
