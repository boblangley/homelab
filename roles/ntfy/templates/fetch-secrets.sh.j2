#!/bin/sh
# Managed by Ansible (homelab repo, role ntfy).
# Reads ntfy's users and tokens from OpenBao through the Wyrwood socket, every hour, into /secrets (an in-memory
# volume), one file per value, for ntfy's entrypoint. Each value must use only the characters of names, bcrypt
# hashes and tokens, so a plain sed extracts it from the JSON and nothing in it can be misread.
set -u
ok='^[A-Za-z0-9$./:,_-]+$'

field() {
  printf '%s' "$1" | sed -n "s/.*\"$2\":\"\([^\"]*\)\".*/\1/p"
}

save() {
  printf '%s' "$2" > "/secrets/.$1"
  chown {{ ntfy_uid }}:{{ ntfy_uid }} "/secrets/.$1"
  chmod 0400 "/secrets/.$1"
  mv -f "/secrets/.$1" "/secrets/$1"
}

while :; do
  if body=$(curl -sf --unix-socket /run/wyrwood/vault.sock http://wyrwood/v1/kv/data/homelab/ntfy); then
    users=$(field "$body" auth_users)
    tokens=$(field "$body" auth_tokens)
    if printf '%s' "$users" | grep -Eq "$ok" && printf '%s' "$tokens" | grep -Eq "$ok"; then
      save auth_users "$users"
      save auth_tokens "$tokens"
      echo "ntfy-secrets: loaded"
      sleep 3600
      continue
    fi
    echo "ntfy-secrets: homelab/ntfy lacks auth_users or auth_tokens, or they have unexpected characters"
  else
    echo "ntfy-secrets: can't read homelab/ntfy through vault.sock"
  fi
  sleep 30
done
