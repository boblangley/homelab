# Managed by Ansible (homelab repo, role wyrd).
# Secrets are files (role-id, secret-id); everything else Xolotl keeps is in OpenBao (namespace wyrwood, kv/xolotl/...).

[server]
listen = "0.0.0.0:8317"
public_url = "https://xolotl.internal"

[database]
path = "/data/xolotl.db"
retention_days = 90

[vault]
address = "https://openbao.internal:8200"
# Shared with Wyrwood, so bindings can hand workspaces their Xolotl client keys.
namespace = "wyrwood"
mount = "kv"
prefix = "xolotl"
ca_cert = "/etc/xolotl/homelab-root.crt"

[vault.approle]
mount = "approle"
role_id_file = "/run/secrets/xolotl_role_id"
secret_id_file = "/run/secrets/xolotl_secret_id"

[telemetry]
service_name = "xolotl"
log_format = "json"
log_filter = "info"

[ui.oidc]
issuer = "https://pocketid.internal"
client_id = "{{ wyrd_ids.xolotl_client_id }}"
redirect_url = "https://xolotl.internal/admin/session/callback"
admin_group = "xolotl_admins"
