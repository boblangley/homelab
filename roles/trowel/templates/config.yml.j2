# Managed by Ansible (homelab repo, role trowel). Trowel rereads this file when it changes.
server:
  listen: ":8080"
  read_header_timeout: 10s

nats:
  url: tls://nats.internal:4222
  name: trowel
  creds_vault: {path: homelab/nats/trowel, field: creds}

# The Wyrwood socket adds the binding's token, so no auth section.
vault:
  address: unix:///run/wyrwood/vault.sock
  kv_mount: kv

{% set github = [] %}
{% for org in trowel_github_orgs %}
{%   set _ = github.append({
       'path': '/github/' ~ org,
       'subject': 'github.{headers.X-Github-Owner}.{headers.X-Github-Repo}.{headers.X-GitHub-Event}.{headers.X-Github-Action}',
       'max_body_bytes': 8388608,
       'message_id_header': 'X-GitHub-Delivery',
       'transform': {'headers': trowel_github_transform},
       'verify': {'hmac': {
         'algorithm': 'sha256', 'header': 'X-Hub-Signature-256', 'prefix': 'sha256=', 'encoding': 'hex',
         'secret_vault': {'path': 'homelab/trowel/github/' ~ org, 'field': 'webhook_secret'}}},
     }) %}
{% endfor %}
{{ {'webhooks': github + trowel_webhooks} | to_block_yaml }}
