# Managed by Ansible (homelab repo, role identity).
services:
  pocketid:
    image: pocketid/pocket-id:{{ identity_pocketid_version }}
    container_name: pocketid
    restart: unless-stopped
    environment:
      APP_URL: https://pocketid.internal
      ENCRYPTION_KEY_FILE: /var/run/encryption_key
      TRUST_PROXY: "true"
      TRUSTED_PLATFORM: X-Real-IP
    labels:
      caddy: pocketid.internal
      caddy.reverse_proxy: "{{ '{{' }}upstreams 1411{{ '}}' }}"
      caddy.reverse_proxy.header_up: "X-Real-IP {remote_host}"
      caddy.import: openbao_tls
    volumes:
      - {{ identity_data }}/pocketid:/app/data
      - ./encryption.key:/var/run/encryption_key:ro
    healthcheck:
      test: ["CMD", "/app/pocket-id", "healthcheck"]
      interval: 1m30s
      timeout: 5s
      retries: 2
      start_period: 10s
    networks:
      homelab:

networks:
  homelab:
    external: true
