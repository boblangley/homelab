# Managed by Ansible (homelab repo, role deck).
listen:
  ssh: ":2222"
  # Inside the container; the image's health check uses it.
  health: "127.0.0.1:8080"

# The Wyrwood socket adds the binding's token, so no auth section.
vault:
  address: unix:///run/wyrwood/vault.sock
  kv_mount: kv

host_key:
  path: homelab/deck/host
  field: private_key

nats:
  servers:
    - tls://nats.internal:4222
  name: deck
  creds:
    path: homelab/nats/deck
    field: creds
  subject_prefix: deck
  stream:
    name: DECK
    max_age: {{ deck_retention }}
    manage: true
  threads:
    bucket: deck-threads
    manage: true

{{ {'bots': deck_bots} | to_nice_yaml(indent=2, width=1000, sort_keys=false) }}
{# Discord IDs as strings, even when host_vars leaves them unquoted and YAML reads them as integers. #}
{% set keys = [] %}
{% for key in deck_keys %}
{%   set grants = [] %}
{%   for grant in key.grants %}
{%     set _ = grants.append({'bot': grant.bot, 'server': grant.server | string,
                              'channels': grant.channels | map('string') | list}) %}
{%   endfor %}
{%   set _ = keys.append({'name': key.name, 'public_key': key.public_key, 'grants': grants}) %}
{% endfor %}
{{ {'keys': keys} | to_nice_yaml(indent=2, width=1000, sort_keys=false) }}
