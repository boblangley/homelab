#!/usr/bin/env python3
# Managed by Ansible (homelab repo, role nats).
# Creates the JetStream streams and consumers in account APP, and edits a stream whose settings differ. Prints one
# line per change. --check: only print what would change.
import json, subprocess, sys

STREAMS = {{ nats_streams | to_json }}
CONSUMERS = {{ nats_consumers | to_json }}
CHECK = "--check" in sys.argv[1:]

def nats(*args):
    cmd = ["docker", "run", "--rm", "--network", "homelab",
           "-v", "{{ nats_dir }}/admin.creds:/admin.creds:ro",
           "-v", "/etc/ssl/certs/ca-certificates.crt:/ca.crt:ro",
           "natsio/nats-box:{{ nats_box_version }}",
           "nats", "--server", "tls://{{ nats_name }}:4222", "--tlsca", "/ca.crt", "--creds", "/admin.creds", *args]
    return subprocess.run(cmd, capture_output=True, text=True)

def names(kind, *parent):
    r = nats(kind, "ls", *parent, "--names")
    if r.returncode != 0:
        sys.exit(f"{kind} ls {' '.join(parent)}: {r.stderr.strip()}")
    return r.stdout.split()

def info(kind, *path):
    r = nats(kind, "info", *path, "--json")
    if r.returncode != 0:
        sys.exit(f"{kind} info {' '.join(path)}: {r.stderr.strip()}")
    return json.loads(r.stdout)["config"]

def run(*args):
    if CHECK:
        return
    r = nats(*args)
    if r.returncode != 0:
        sys.exit(f"{' '.join(args[:3])}: {r.stderr.strip()}")

existing_streams = names("stream")
for name, s in STREAMS.items():
    want = {
        "subjects": s["subjects"],
        "max_age": s["max_age_days"] * 86400 * 10**9,
        "max_bytes": s["max_gib"] * 2**30,
        "max_msg_size": s["max_msg_mib"] * 2**20,
        "duplicate_window": s.get("dupe_window_s", 120) * 10**9,
    }
    flags = ["--subjects", ",".join(s["subjects"]), "--max-age", f"{s['max_age_days']}d",
             "--max-bytes", f"{s['max_gib']}GB", "--max-msg-size", f"{s['max_msg_mib']}MB",
             "--dupe-window", f"{s.get('dupe_window_s', 120)}s"]
    if name not in existing_streams:
        run("stream", "add", name, *flags, "--storage", "file", "--retention", "limits", "--discard", "old",
            "--replicas", "1", "--defaults")
        print(f"created stream {name}")
    elif any(info("stream", name).get(k) != v for k, v in want.items()):
        run("stream", "edit", name, *flags, "--force")
        print(f"edited stream {name}")

for c in CONSUMERS:
    # In a preview, a stream that would be created has no consumers yet.
    if c["stream"] not in existing_streams or c["name"] not in names("consumer", c["stream"]):
        run("consumer", "add", c["stream"], c["name"], "--pull", "--deliver", "all", "--ack", "explicit",
            "--wait", "30s", "--max-deliver=-1", "--defaults")
        print(f"created consumer {c['stream']}/{c['name']}")
