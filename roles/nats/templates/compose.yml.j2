# Managed by Ansible (homelab repo, role nats).
services:
  nats:
    image: nats:{{ nats_version }}
    container_name: nats
    restart: unless-stopped
    user: "{{ nats_uid }}:{{ nats_uid }}"
    command: ["--config", "/etc/nats/config/nats.conf"]
    volumes:
      # A directory, not the file: Ansible replaces the file, and a file mount would keep the old one.
      - ./config:/etc/nats/config:ro
      - ./tls:/etc/nats/tls:ro
      - {{ nats_data }}:/data
    healthcheck:
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:8222/healthz"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    networks:
      homelab:
        aliases:
          - {{ nats_name }}

networks:
  homelab:
    external: true
