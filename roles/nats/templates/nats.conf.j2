# Managed by Ansible (homelab repo, role nats). Readable only by the server: it has the password users' bcrypt hashes.
server_name: nats
listen: 0.0.0.0:4222

# Monitoring stays inside the container; the health check uses it.
http: 127.0.0.1:8222

max_payload: {{ nats_max_payload }}

tls {
  cert_file: /etc/nats/tls/tls.crt
  key_file: /etc/nats/tls/tls.key
}

jetstream {
  store_dir: /data
}

system_account: SYS

accounts {
  SYS {}
  APP {
    jetstream: enabled
    users: [
{% for name, key in nats_users | dictsort %}
      { nkey: {{ key }} }  # {{ name }}
{% endfor %}
{% for name, perms in nats_password_users | dictsort %}
      { user: {{ name }}, password: "{{ nats_bcrypt[name] }}", permissions: {
          publish: {{ perms.publish | default([]) | to_json }}
          subscribe: {{ perms.subscribe | default([]) | to_json }} } }
{% endfor %}
    ]
  }
}
