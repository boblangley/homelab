# Managed by Ansible (homelab repo, role nats).
server_name: nats
listen: 0.0.0.0:4222

# Monitoring stays inside the container; the health check uses it.
http: 127.0.0.1:8222

max_payload: {{ nats_max_payload }}

tls {
  cert_file: /etc/nats/tls/tls.crt
  key_file: /etc/nats/tls/tls.key
}

jetstream {
  store_dir: /data
}

# Operator homelab, system account SYS and account APP: the operator and account JWTs, from OpenBao.
include resolver.conf
