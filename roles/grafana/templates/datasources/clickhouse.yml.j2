# Managed by Ansible (homelab repo, role grafana).
# The uid is fixed, so dashboards in the repo can name this data source.
apiVersion: 1

datasources:
  - name: ClickHouse
    uid: clickhouse
    type: grafana-clickhouse-datasource
    isDefault: true
    editable: false
    jsonData:
      host: {{ grafana_clickhouse_host }}
      port: 9440
      protocol: native
      secure: true
      username: {{ grafana_clickhouse_user }}
      defaultDatabase: otel
      # The OpenTelemetry gateway's tables, in the exporter's schema.
      logs:
        defaultDatabase: otel
        defaultTable: otel_logs
        otelEnabled: true
        otelVersion: latest
      traces:
        defaultDatabase: otel
        defaultTable: otel_traces
        otelEnabled: true
        otelVersion: latest
        durationUnit: nanoseconds
    secureJsonData:
      password: $__file{/run/secrets/grafana/clickhouse_password}
